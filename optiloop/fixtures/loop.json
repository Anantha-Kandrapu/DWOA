{
  "name": "code-fix-agent",
  "steps": [
    {
      "id": "plan",
      "role": "planner",
      "model": "gpt-4o",
      "touches_pii": false,
      "prompt": "Follow repository instructions.\nFix the reported parser bug.\nFollow repository instructions.\nOptional context: explore unrelated refactors.",
      "tools": []
    },
    {
      "id": "read",
      "role": "observer",
      "model": "gpt-4o",
      "touches_pii": true,
      "prompt": "Read only the files needed for the parser bug.\nPreserve user changes.\nRead only the files needed for the parser bug.",
      "tools": [
        {"id": "read-1", "name": "read_file", "args": {"path": "parser.py"}, "side_effect": false},
        {"id": "read-2", "name": "read_file", "args": {"path": "parser.py"}, "side_effect": false}
      ]
    },
    {
      "id": "edit",
      "role": "actor",
      "model": "gpt-4o",
      "touches_pii": false,
      "prompt": "Make the smallest correct edit.\nDo not modify unrelated files.\nMake the smallest correct edit.",
      "tools": [
        {"id": "write-1", "name": "write_file", "args": {"path": "parser.py"}, "side_effect": true}
      ]
    },
    {
      "id": "verify",
      "role": "critic",
      "model": "gpt-4o",
      "touches_pii": false,
      "prompt": "Run the focused regression check.\nReport the result clearly.\nRun the focused regression check.",
      "tools": [
        {"id": "test-1", "name": "run_tests", "args": {"target": "parser"}, "side_effect": false},
        {"id": "test-2", "name": "run_tests", "args": {"target": "parser"}, "side_effect": false}
      ]
    }
  ]
}
